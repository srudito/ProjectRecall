# Public Expo configuration only. Values with EXPO_PUBLIC_ are embedded in the app bundle.
# Never place service-role keys, database passwords, JWT secrets, OAuth client secrets,
# access tokens, refresh tokens, or signing credentials in this file.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
# Supabase publishable key or legacy anon-role JWT only. Never use sb_secret or service_role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_BACKEND_URL=

# Public release contact/legal values. Production EAS builds fail when these are
# missing or point to example/reserved domains. Leave blank until real values exist.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=
